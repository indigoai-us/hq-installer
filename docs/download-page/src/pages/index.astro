---
import { fetchLatestRelease, formatBytes, formatDate } from "../lib/release.ts";

// Runs on every ISR revalidation (hourly). Rendered HTML is cached by
// Vercel — fresh visitors get a cache hit until the TTL expires.
const release = await fetchLatestRelease();

const aarch64Url = release?.dmgAarch64?.browserDownloadUrl ?? null;
const x64Url = release?.dmgX64?.browserDownloadUrl ?? null;
const aarch64Size = release?.dmgAarch64 ? formatBytes(release.dmgAarch64.size) : null;
const x64Size = release?.dmgX64 ? formatBytes(release.dmgX64.size) : null;
const universalUrl = release?.macUniversal?.asset.browserDownloadUrl ?? null;
const universalSize = release?.macUniversal ? formatBytes(release.macUniversal.asset.size) : null;
const universalFormat = release?.macUniversal?.format ?? null;
// v0.1.11 shipped .dmg; v0.1.12+ ships .zip (Safari auto-extracts, no
// drag-to-Applications). When a universal artifact is present we render
// one primary button instead of the old arch-split pair. The subtitle
// shows the distribution format so users know what they're getting.
const showUniversal = Boolean(universalUrl);
// Format-specific subtitle copy. Each arm stays short enough to fit in
// the secondary slot on mobile (btn-os line, ~36ch).
const universalSubtitle = universalFormat === "zip"
  ? "Universal · Notarized .zip — opens on double-click"
  : universalFormat === "dmg"
    ? "Universal · Notarized .dmg — Apple Silicon + Intel"
    : universalFormat === "app.tar.gz"
      ? "Universal · Notarized .app.tar.gz (advanced)"
      : "Universal · Apple Silicon + Intel";
const releaseDate = release ? formatDate(release.publishedAt) : null;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="HQ — an AI operating system for your whole company. Orchestrate work across companies, workers, and AI. Download the native macOS installer." />
    <meta name="theme-color" content="#09090b" />
    <title>HQ — Download</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://install.getindigo.ai" />
    <meta property="og:title" content="HQ — Download" />
    <meta property="og:description" content="An AI operating system for your whole company — orchestrate work across companies, workers, and AI, with Claude Code driving." />
    <meta property="og:type" content="website" />

    <!--
      Fonts — Geist + Geist Mono. Same family hq-console and
      www.getindigo.ai share: Geist for body, Geist Mono for metadata,
      labels, and CTAs. Single stylesheet request covers both.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <main class="root">
      <nav class="topbar" aria-label="Indigo">
        <a class="topbar-home" href="https://www.getindigo.ai" aria-label="Indigo home">
          <img
            src="/indigo-logo.svg"
            alt="Indigo"
            width="84"
            height="20"
            decoding="async"
          />
        </a>
        <a class="topbar-link" href="https://www.getindigo.ai/sync">
          HQ Sync <span aria-hidden="true">→</span>
        </a>
      </nav>

      <header class="hero">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="logo">
          <img
            class="logo-mark"
            src="/hq-logomark.svg"
            alt="HQ"
            width="116"
            height="67"
            decoding="async"
          />
        </div>
        <h1>An AI operating system for your whole company.</h1>
        <p class="tagline">
          Orchestrate work across companies, workers, and AI from one place —
          open source, on your machine, with Claude Code driving.
        </p>
      </header>

      <section class="download-card" aria-labelledby="download-heading">
        <span class="bracket bracket--tl" aria-hidden="true"></span>
        <span class="bracket bracket--tr" aria-hidden="true"></span>
        <span class="bracket bracket--bl" aria-hidden="true"></span>
        <span class="bracket bracket--br" aria-hidden="true"></span>

        <h2 id="download-heading">Download HQ Installer</h2>

        <!--
          Access-funnel handoff banner (hq-access-funnel, in-proj-072). Hidden
          by default; revealed client-side when the page is reached via the
          post-grant handoff with a `company` param. See lib/onboarding-context.ts.
        -->
        <div id="onboarding-banner" class="onboarding-banner" role="status" hidden>
          Setting up HQ for <span id="onboarding-banner-company"></span> — download
          below and we&apos;ll pick up where your demo left off.
        </div>

        {release ? (
          <div class="release-meta">
            <span class="tag">{release.tag}</span>
            <span class="published">Released {releaseDate}</span>
          </div>
        ) : (
          <div class="release-meta release-meta--pending">
            <span class="tag tag--pending">coming soon</span>
            <span class="published">The first public release is being prepared.</span>
          </div>
        )}

        <div class="buttons" id="buttons">
          {showUniversal ? (
            <a
              id="btn-universal"
              class="btn btn-primary"
              href={universalUrl ?? "#"}
              data-arch="universal"
              aria-disabled={!universalUrl}
              data-state={universalUrl ? "ready" : "pending"}
            >
              <span class="btn-arch">Download for macOS</span>
              <span class="btn-os">{universalSubtitle}</span>
              {universalSize && <span class="btn-size">{universalSize}</span>}
            </a>
          ) : (
            <>
              <a
                id="btn-aarch64"
                class="btn btn-primary"
                href={aarch64Url ?? "#"}
                data-arch="aarch64"
                aria-disabled={!aarch64Url}
                data-state={aarch64Url ? "ready" : "pending"}
              >
                <span class="btn-arch">Apple Silicon</span>
                <span class="btn-os">macOS · M1 / M2 / M3 / M4</span>
                {aarch64Size && <span class="btn-size">{aarch64Size}</span>}
              </a>

              <a
                id="btn-x64"
                class="btn btn-secondary"
                href={x64Url ?? "#"}
                data-arch="x64"
                aria-disabled={!x64Url}
                data-state={x64Url ? "ready" : "pending"}
              >
                <span class="btn-arch">Intel Mac</span>
                <span class="btn-os">macOS · x86_64</span>
                {x64Size && <span class="btn-size">{x64Size}</span>}
              </a>
            </>
          )}
        </div>

        <p class="os-hint" id="os-hint" aria-live="polite"></p>

        <p class="also">
          Also available for:
          <span class="soon">Windows (soon)</span> ·
          <span class="soon">Linux (soon)</span>
        </p>

        <p class="security-note">
          Signed with Indigo's Apple Developer ID and notarized by Apple.
          No Gatekeeper warnings.
        </p>
      </section>

      <section class="devs" aria-labelledby="devs-heading">
        <div class="devs-bar">
          <div class="devs-dots" aria-hidden="true">
            <span class="dot dot--rose"></span>
            <span class="dot dot--amber"></span>
            <span class="dot dot--green"></span>
          </div>
          <span class="devs-title" id="devs-heading">for developers</span>
          <span class="devs-lang">shell</span>
        </div>
        <div class="devs-body">
          <p>
            Comfortable in a terminal? Skip the installer and bootstrap HQ with
            one command:
          </p>
          <pre class="code"><code><span class="code-prompt">$</span> npx create-hq</code></pre>
        </div>
      </section>

      <section class="resources" aria-labelledby="resources-heading">
        <h2 class="section-label" id="resources-heading">learn hq</h2>

        <a class="resource resource--featured" href="https://www.getindigo.ai/book">
          <span class="resource-arrow" aria-hidden="true">→</span>
          <span class="resource-head">
            <span class="resource-title">Build Your Own AGI</span>
            <span class="resource-tag">free book</span>
          </span>
          <span class="resource-desc">
            The book behind HQ — 11 chapters, zero filler, on building your
            own AGI.
          </span>
        </a>

        <div class="resource-grid">
          <a class="resource" href="https://docs.getindigo.ai">
            <span class="resource-arrow" aria-hidden="true">→</span>
            <span class="resource-title">Docs</span>
            <span class="resource-desc">Setup, skills, workers, and the full reference.</span>
          </a>
          <a class="resource" href="https://world.getindigo.ai">
            <span class="resource-arrow" aria-hidden="true">→</span>
            <span class="resource-title">HQ World</span>
            <span class="resource-desc">Training, courses, and the community.</span>
          </a>
          <a class="resource" href="https://github.com/indigoai-us/hq">
            <span class="resource-arrow" aria-hidden="true">→</span>
            <span class="resource-title">Open source</span>
            <span class="resource-desc">Star, fork, and read the source on GitHub.</span>
          </a>
          <a class="resource" href="https://github.com/coreyepstein/ralph-methodology">
            <span class="resource-arrow" aria-hidden="true">→</span>
            <span class="resource-title">The Ralph method</span>
            <span class="resource-desc">The orchestration loop that ships work autonomously.</span>
          </a>
        </div>
      </section>

      <footer class="footer">
        <p class="footer-links">
          <a href="https://www.getindigo.ai">Indigo home</a>
          <span class="footer-sep" aria-hidden="true">·</span>
          <a href="https://www.getindigo.ai/sync">Download HQ Sync for macOS</a>
          <span class="footer-sep" aria-hidden="true">·</span>
          {release ? (
            <a href={release.htmlUrl}>Releases on GitHub <span aria-hidden="true">→</span></a>
          ) : (
            <a href="https://github.com/indigoai-us/hq-installer">Source on GitHub <span aria-hidden="true">→</span></a>
          )}
        </p>
        <p class="copyright">© 2026 Indigo. HQ is open source.</p>
      </footer>
    </main>

    <script is:inline>
      // OS detection — client-side only. Runs after HTML is cached, so
      // ISR doesn't need to re-render per-visitor. We enhance the
      // already-rendered download buttons with an emphasized state +
      // an inline hint above the buttons.
      (function () {
        try {
          const ua = navigator.userAgent || "";
          // navigator.platform is deprecated in the spec but still the
          // only cross-browser path for OS detection on Safari, where
          // navigator.userAgentData does not exist. We keep both.
          /** @type {{ platform?: string }} */
          const nav = /** @type {unknown} */ (navigator);
          const platform = nav.platform || "";

          const isMac = /Mac/i.test(platform) || /Mac/i.test(ua);
          const isWindows = /Win/i.test(platform) || /Windows/i.test(ua);
          const isLinux = /Linux/i.test(platform) || /Linux/i.test(ua);

          // Modern AS Macs report "MacIntel" in platform, but we can
          // still infer Apple Silicon via the "Mac OS X" token in UA
          // combined with a WebKit device memory probe. Browsers try
          // to hide this — fallback is to highlight aarch64 since that's
          // ~80% of new Macs sold and the safer default.
          const isAppleSilicon = (() => {
            if (!isMac) return false;
            // Chrome 91+ ships navigator.userAgentData — arm64 reports
            // architecture "arm" here.
            const uaData = /** @type {{architecture?: string}} */ (
              /** @type {unknown} */ (navigator).userAgentData
            );
            if (uaData && uaData.architecture) {
              return uaData.architecture === "arm";
            }
            // Fallback: default to aarch64 for any Mac newer than 2020.
            return true;
          })();

          const hint = document.getElementById("os-hint");
          const btnA = document.getElementById("btn-aarch64");
          const btnX = document.getElementById("btn-x64");
          const btnU = document.getElementById("btn-universal");

          if (isMac) {
            if (btnU) {
              // Universal build — one button, always featured on Mac.
              btnU.classList.add("btn-featured");
              hint && (hint.textContent = isAppleSilicon
                ? "Detected: macOS on Apple Silicon — this universal build runs natively."
                : "Detected: macOS on Intel — this universal build runs natively.");
            } else if (isAppleSilicon) {
              btnA && btnA.classList.add("btn-featured");
              hint && (hint.textContent = "Detected: macOS on Apple Silicon — the top button is the one you want.");
            } else {
              btnX && btnX.classList.add("btn-featured");
              hint && (hint.textContent = "Detected: macOS on Intel — use the Intel Mac button.");
            }
          } else if (isWindows) {
            hint && (hint.textContent = "Detected: Windows. Native installer coming soon — for now, try npx create-hq.");
            btnA && btnA.classList.add("btn-dim");
            btnX && btnX.classList.add("btn-dim");
            btnU && btnU.classList.add("btn-dim");
          } else if (isLinux) {
            hint && (hint.textContent = "Detected: Linux. Native installer coming soon — for now, try npx create-hq.");
            btnA && btnA.classList.add("btn-dim");
            btnX && btnX.classList.add("btn-dim");
            btnU && btnU.classList.add("btn-dim");
          }
        } catch {
          // Silently no-op on any runtime error — the static HTML still
          // works fine without JS.
        }
      })();
    </script>

    <style>
      /* ──────────────────────────────────────────────────────────────
         hq-installer download page — getindigo.ai monochrome register
         Near-black background, single indigo accent used as punctuation
         (never as a surface). White primary CTA per the indigo-marketing
         brand rule. Geist + Geist Mono — the family hq-console and
         www.getindigo.ai share. Corner brackets + terminal-card motifs
         lifted from components/hq/*. Honors prefers-reduced-motion.
         ────────────────────────────────────────────────────────────── */

      :root {
        --bg: #09090b;
        --bg-card: #111113;
        --bg-elevated: #18181b;
        --border: rgba(255, 255, 255, 0.06);
        --border-accent: rgba(255, 255, 255, 0.12);
        --text-primary: #fafafa;
        --text-secondary: #a1a1aa;
        --text-muted: #52525b;
        --accent: #818cf8;          /* indigo — accents only */
        --accent-dim: #6366f1;
        --accent-glow: rgba(99, 102, 241, 0.08);
        --green: #34d399;
        --amber: #fbbf24;
        --cyan: #22d3ee;
        --rose: #fb7185;
        --font-sans: "Geist", system-ui, -apple-system, sans-serif;
        --font-mono: "Geist Mono", ui-monospace, SFMono-Regular, "SF Mono",
          Menlo, Consolas, monospace;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text-secondary);
        font-family: var(--font-sans);
        font-size: 14px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        min-height: 100vh;
      }

      /* Focus rings — keyboard a11y floor. Indigo accent against
         near-black ≈ AA+; offset keeps it off the element edge. */
      a:focus-visible,
      button:focus-visible,
      [tabindex]:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 2px;
        border-radius: 2px;
      }

      .root {
        max-width: 600px;
        margin: 0 auto;
        padding: 28px 24px 80px;
        position: relative;
      }

      /* ── Topbar ─────────────────────────────────────── */
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 56px;
        position: relative;
        z-index: 2;
      }

      .topbar-home {
        display: inline-flex;
        align-items: center;
        opacity: 0.8;
        transition: opacity 200ms var(--ease);
      }

      .topbar-home:hover {
        opacity: 1;
      }

      .topbar-home img {
        display: block;
        height: 20px;
        width: auto;
        /* Source SVG is near-black (#141414). Invert to the off-white
           foreground so it reads on the near-black background. */
        filter: brightness(0) invert(0.98);
      }

      .topbar-link {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.01em;
        color: var(--text-muted);
        text-decoration: none;
        transition: color 200ms var(--ease);
      }

      .topbar-link:hover {
        color: var(--text-primary);
      }

      .topbar-link span {
        color: var(--accent);
      }

      /* ── Hero ───────────────────────────────────────── */
      .hero {
        text-align: center;
        margin-bottom: 48px;
        position: relative;
        isolation: isolate;
      }

      /* One restrained accent moment — a soft indigo bloom behind the
         mark. Replaces the old full-spectrum prism beam: single hue,
         low opacity, no animation. Accent as punctuation, not surface. */
      .hero-glow {
        position: absolute;
        top: -30px;
        left: 50%;
        width: 320px;
        height: 220px;
        transform: translateX(-50%);
        background: radial-gradient(
          ellipse at center,
          var(--accent-glow) 0%,
          transparent 70%
        );
        z-index: -1;
        pointer-events: none;
      }

      .logo {
        margin-bottom: 28px;
        line-height: 0;
        animation: rise 600ms var(--ease) both;
      }

      .logo-mark {
        display: inline-block;
        height: 64px;
        width: auto;
      }

      @media (max-width: 480px) {
        .logo-mark {
          height: 52px;
        }
      }

      .hero h1 {
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 30px;
        line-height: 1.18;
        margin: 0 0 16px;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        animation: rise 600ms var(--ease) 60ms both;
      }

      .tagline {
        font-size: 15px;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0 auto;
        max-width: 460px;
        animation: rise 600ms var(--ease) 120ms both;
      }

      /* ── Download card ──────────────────────────────── */
      .download-card {
        position: relative;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 28px 24px 24px;
        margin-bottom: 20px;
        animation: rise 600ms var(--ease) 180ms both;
      }

      /* Corner brackets — indigo /30 tick marks. Lifted from
         components/hq/corner-brackets.tsx (the marketing-site motif). */
      .bracket {
        position: absolute;
        width: 14px;
        height: 14px;
        border: 0 solid color-mix(in srgb, var(--accent) 30%, transparent);
        pointer-events: none;
      }
      .bracket--tl { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
      .bracket--tr { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; }
      .bracket--bl { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; }
      .bracket--br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }

      .download-card h2 {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.02em;
        text-transform: lowercase;
        color: var(--text-muted);
        margin: 0 0 18px;
      }

      .release-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        font-size: 12px;
      }

      /* Status badge — accent-tinted, ready state. Pending uses the
         muted/amber register so it reads as "not yet" without alarm. */
      .tag {
        display: inline-flex;
        align-items: center;
        padding: 3px 9px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--accent) 8%, transparent);
        color: var(--accent);
        border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.01em;
      }

      .tag--pending {
        background: color-mix(in srgb, var(--amber) 8%, transparent);
        color: var(--amber);
        border-color: color-mix(in srgb, var(--amber) 30%, transparent);
      }

      .published {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-muted);
        letter-spacing: 0.01em;
      }

      /* ── Buttons ────────────────────────────────────── */
      .buttons {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .btn {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        border-radius: 10px;
        text-decoration: none;
        transition:
          background 180ms var(--ease),
          border-color 180ms var(--ease),
          box-shadow 180ms var(--ease),
          transform 180ms var(--ease);
        position: relative;
      }

      /* Primary download — white fill, near-black text. The
         indigo-marketing brand rule (2026-04-24): every primary
         download / sign-up is white, never periwinkle. */
      .btn-primary {
        background: var(--text-primary);
        color: var(--bg);
        border: 1px solid var(--text-primary);
        box-shadow: 0 0 24px -8px rgba(255, 255, 255, 0.35);
      }

      .btn-primary .btn-os {
        color: color-mix(in srgb, var(--bg) 65%, transparent);
      }

      .btn-primary .btn-size {
        color: color-mix(in srgb, var(--bg) 55%, transparent);
      }

      .btn-primary:hover {
        background: #ffffff;
        border-color: #ffffff;
        box-shadow: 0 0 32px -6px rgba(255, 255, 255, 0.5);
        transform: translateY(-1px);
      }

      /* Secondary — hairline outline, ghost fill. */
      .btn-secondary {
        background: transparent;
        color: var(--text-primary);
        border: 1px solid var(--border-accent);
      }

      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.22);
      }

      .btn[aria-disabled="true"] {
        opacity: 0.35;
        pointer-events: none;
      }

      /* Featured (OS-detection match) — lift the indigo accent rim so
         the matched button reads as "the one for you" without changing
         the white-CTA rule. */
      .btn-featured {
        box-shadow:
          0 0 0 1px color-mix(in srgb, var(--accent) 50%, transparent),
          0 0 32px -6px rgba(129, 140, 248, 0.45);
      }

      .btn-featured:hover {
        box-shadow:
          0 0 0 1px var(--accent),
          0 0 40px -4px rgba(129, 140, 248, 0.55);
      }

      .btn-dim {
        opacity: 0.45;
      }

      .btn-arch {
        font-family: var(--font-mono);
        font-weight: 500;
        font-size: 14px;
        letter-spacing: 0.01em;
        flex: 1;
      }

      .btn-os {
        font-size: 12px;
        color: var(--text-secondary);
      }

      .btn-size {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-muted);
        letter-spacing: 0.01em;
      }

      .os-hint {
        margin: 16px 0 0;
        font-size: 12px;
        color: var(--text-muted);
        min-height: 18px;
      }

      .also {
        margin: 22px 0 8px;
        font-size: 12px;
        color: var(--text-muted);
      }

      .soon {
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.01em;
      }

      .security-note {
        margin: 14px 0 0;
        font-size: 12px;
        color: var(--text-muted);
        line-height: 1.55;
      }

      /* ── Dev path — terminal card ───────────────────── */
      /* Mirrors components/hq/terminal-card.tsx: traffic-light dots,
         mono title bar, code body. Cyan accent on the command echoes
         the marketing-site create-hq card. */
      .devs {
        overflow: hidden;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 12px;
        margin-bottom: 44px;
        animation: rise 600ms var(--ease) 240ms both;
      }

      .devs-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--border);
      }

      .devs-dots {
        display: flex;
        gap: 6px;
      }

      .dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
      }
      .dot--rose { background: color-mix(in srgb, var(--rose) 40%, transparent); }
      .dot--amber { background: color-mix(in srgb, var(--amber) 40%, transparent); }
      .dot--green { background: color-mix(in srgb, var(--green) 40%, transparent); }

      .devs-title {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-muted);
        flex: 1;
      }

      .devs-lang {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-muted);
      }

      .devs-body {
        padding: 18px 18px 20px;
      }

      .devs-body p {
        margin: 0 0 14px;
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.6;
      }

      .code {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 12px 14px;
        margin: 0;
        overflow-x: auto;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--cyan);
        user-select: all;
      }

      .code-prompt {
        color: var(--text-muted);
        user-select: none;
        margin-right: 8px;
      }

      /* ── Resources — learn hq ───────────────────────── */
      .resources {
        margin-bottom: 44px;
        animation: rise 600ms var(--ease) 300ms both;
      }

      .section-label {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.02em;
        text-transform: lowercase;
        color: var(--text-muted);
        margin: 0 0 14px;
      }

      .resource {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 16px 18px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 10px;
        text-decoration: none;
        transition:
          background 180ms var(--ease),
          border-color 180ms var(--ease),
          transform 180ms var(--ease);
      }

      .resource:hover {
        background: var(--bg-elevated);
        border-color: var(--border-accent);
        transform: translateY(-1px);
      }

      .resource-arrow {
        position: absolute;
        top: 16px;
        right: 16px;
        font-family: var(--font-mono);
        font-size: 14px;
        color: var(--text-muted);
        transition:
          color 180ms var(--ease),
          transform 180ms var(--ease);
      }

      .resource:hover .resource-arrow {
        color: var(--accent);
        transform: translate(2px, -2px);
      }

      .resource-head {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .resource-title {
        font-family: var(--font-mono);
        font-size: 14px;
        font-weight: 500;
        color: var(--text-primary);
        padding-right: 22px;
      }

      .resource-tag {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.02em;
        color: var(--accent);
        padding: 2px 7px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--accent) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
      }

      .resource-desc {
        font-size: 12.5px;
        color: var(--text-secondary);
        line-height: 1.5;
        padding-right: 22px;
      }

      /* Featured — the book. Accent-tinted rim sets it above the grid. */
      .resource--featured {
        margin-bottom: 12px;
        border-color: color-mix(in srgb, var(--accent) 28%, transparent);
        background: linear-gradient(
          180deg,
          color-mix(in srgb, var(--accent) 5%, var(--bg-card)) 0%,
          var(--bg-card) 100%
        );
      }

      .resource--featured:hover {
        border-color: color-mix(in srgb, var(--accent) 45%, transparent);
      }

      .resource-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      @media (max-width: 480px) {
        .resource-grid {
          grid-template-columns: 1fr;
        }
      }

      /* ── Footer ─────────────────────────────────────── */
      .footer {
        text-align: center;
        font-size: 12px;
        color: var(--text-muted);
        border-top: 1px solid var(--border);
        padding-top: 28px;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin: 0;
      }

      .footer-sep {
        color: var(--text-muted);
        opacity: 0.5;
      }

      .footer a {
        color: var(--text-secondary);
        text-decoration: none;
        transition: color 200ms var(--ease);
      }

      .footer a span {
        color: var(--accent);
      }

      .footer a:hover {
        color: var(--text-primary);
      }

      .copyright {
        margin-top: 16px;
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.02em;
        color: var(--text-muted);
      }

      /* ── Responsive ─────────────────────────────────── */
      @media (max-width: 480px) {
        .root {
          padding: 32px 16px 60px;
        }
        .hero h1 {
          font-size: 25px;
        }
        .download-card {
          padding: 24px 18px 20px;
        }
        .btn {
          flex-direction: column;
          align-items: flex-start;
          gap: 6px;
          padding: 14px 16px;
        }
        .btn-arch {
          flex: none;
        }
      }

      /* ── Motion ─────────────────────────────────────── */
      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .logo,
        .hero h1,
        .tagline,
        .download-card,
        .devs,
        .resources {
          animation: none;
        }
        .btn,
        .footer a,
        .resource,
        .resource-arrow,
        .topbar-home,
        .topbar-link {
          transition: none;
        }
      }

      /* Access-funnel handoff banner (hq-access-funnel). Hidden until the
         capture script reveals it for a funnel arrival. */
      .onboarding-banner {
        margin: 0 0 18px;
        padding: 12px 14px;
        border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
        border-radius: 8px;
        background: color-mix(in srgb, var(--accent) 8%, transparent);
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 12.5px;
        line-height: 1.5;
      }
      .onboarding-banner[hidden] {
        display: none;
      }
      #onboarding-banner-company {
        color: var(--text-primary);
        font-weight: 500;
      }
    </style>

    <!--
      Access-funnel onboarding capture (hq-access-funnel, in-proj-072). Bundled
      (not is:inline) so it can import the pure parser. When the page is reached
      via the post-grant handoff (?company=…&companySlug=…&email=…&track=onboarding),
      it reveals the banner and persists the context to localStorage. A native
      .dmg/.zip cannot carry these params, so this captures + persists only — the
      desktop app bridging the context post-auth is a separate item (see
      docs/access-funnel-onboarding-context.md).
    -->
    <script>
      import {
        parseOnboardingContext,
        hasOnboardingContext,
        contextLabel,
        ONBOARDING_CONTEXT_STORAGE_KEY,
      } from "../lib/onboarding-context.ts";

      try {
        const context = parseOnboardingContext(window.location.search);
        if (hasOnboardingContext(context)) {
          // Persist so a return visit / future app integration can resume it.
          try {
            window.localStorage.setItem(
              ONBOARDING_CONTEXT_STORAGE_KEY,
              JSON.stringify({ ...context, capturedAt: new Date().toISOString() }),
            );
          } catch {
            /* private mode / storage disabled — banner still shows */
          }
          const banner = document.getElementById("onboarding-banner");
          const companyEl = document.getElementById("onboarding-banner-company");
          const label = contextLabel(context);
          if (banner && companyEl && label) {
            companyEl.textContent = label;
            banner.hidden = false;
          }
        }
      } catch {
        /* never let onboarding capture break the download page */
      }
    </script>
  </body>
</html>
